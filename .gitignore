# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Vite cache
.vite/

# SQLite database — created at runtime by server/src/db.ts.
# The -wal and -shm siblings come from WAL journal mode.
server/data/
*.db
*.db-wal
*.db-shm

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Personal Claude Code settings (shared config belongs in .claude/settings.json)
.claude/settings.local.json

# OS cruft — desktop.ini and Thumbs.db show up regularly here because this
# project lives inside a OneDrive-synced folder on Windows.
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
