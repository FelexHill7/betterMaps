# Normalise line endings in the repo to LF, regardless of the OS committing.
# Without this, a Windows checkout commits CRLF and every file reads as fully
# rewritten to a collaborator on Linux or macOS.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary

# Generated: collapse in diffs and exclude from language statistics.
package-lock.json linguist-generated=true -diff
