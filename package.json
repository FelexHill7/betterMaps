{
  "name": "bettermaps",
  "private": true,
  "version": "0.1.0",
  "description": "Collaborative road-trip maps: a shared stop queue the driver can sort by nearest, detour, rating, votes or cost.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "test": "npm run test --workspace server && npm run test --workspace web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
